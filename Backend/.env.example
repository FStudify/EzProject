# ==========================================
# EZProject Backend — Environment Variables
# ==========================================
# LOCAL DEV:  Copy file này thành `.env`, điền MONGO_URI → chạy ngay.
# DEPLOY:     Paste từng key=value vào nền tảng deploy (Render, Railway, Fly.io, …).
#             Các key có giá trị mặc định sẽ hoạt động ngay.
#             Các key TRỐNG (=) là BẮT BUỘC phải điền giá trị thật.
# KHÔNG commit `.env` thật vào git (đã có trong .gitignore).
# ==========================================

# ─── 1. RUNTIME ─────────────────────────────────
# Môi trường: development | production | test
# Deploy: đổi thành production
NODE_ENV=production

# Port backend. Render tự set PORT=10000 ở production.
PORT=10000

# ─── 2. DATABASE — BẮT BUỘC ─────────────────────
# ⚠️ BẮT BUỘC: Phải điền connection string MongoDB Atlas
# Cách lấy: xem docs/19_ENVIRONMENT_GUIDE.md mục 4.1
#   1. Tạo cluster free M0: https://www.mongodb.com/cloud/atlas
#   2. Database Access → Add user (lưu username/password)
#   3. Network Access → Add IP 0.0.0.0/0
#   4. Connect → Drivers → copy connection string
#   5. Thay <USER>, <PASSWORD>, <CLUSTER>, thêm /ezproject trước ?
MONGO_URI=mongodb+srv://EzProject:Ez123Ez@cluster0.g7xba9i.mongodb.net/ezproject?retryWrites=true&w=majority&appName=Cluster0

# ─── 3. JWT — BẮT BUỘC cho production ───────────
# Local dev: có thể dùng giá trị mặc định bên dưới
# Production: PHẢI generate chuỗi random >= 32 ký tự
# Cách generate: xem docs/19_ENVIRONMENT_GUIDE.md mục 4.2
# Render Dashboard có nút "Generate Value" tạo tự động
JWT_SECRET=8f6a9d7c241b4h6f9d0dbe7k5a3a1c9c
JWT_REFRESH_SECRET=92abdnef8d61cac8a1e9f54t7b20ag11
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── 4. CORS / FRONTEND URL ─────────────────────
# Nhiều origin cách nhau bằng dấu phẩy, KHÔNG có dấu cách.
# Local dev:  http://localhost:5173
# Production: https://your-app.vercel.app
CORS_ORIGIN=https://ezproject1.vercel.app

# URL public của FE — dùng để build link invite trong email.
# KHÔNG có dấu / ở cuối.
# Local dev:  http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=https://ezproject1.vercel.app

# ─── 5. AVATAR UPLOAD (Cloudinary) — OPTIONAL ───
# Để trống → avatar upload sẽ báo lỗi rõ ràng; user phải dùng URL ảnh ngoài.
# Cách lấy: xem docs/19_ENVIRONMENT_GUIDE.md mục 4.5
# Đăng ký miễn phí: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=djgk6czgq
CLOUDINARY_API_KEY=125374671537146
CLOUDINARY_API_SECRET=mAkBD1PF9HTIuBrZMnlbX9qjuN8

# ─── 6. EMAIL / SMTP — OPTIONAL ─────────────────
# Để trống → hệ thống log inviteUrl ra console (dev mode), không gửi email.
# Cách setup: xem docs/19_ENVIRONMENT_GUIDE.md mục 4.6
#
# Resend (khuyến nghị, free 100 email/ngày):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASS=<api-key>
#   SMTP_FROM=EZProject <noreply@yourdomain.com>
#
# Gmail App Password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=<16-char-app-password>
#   SMTP_FROM=EZProject <your-email@gmail.com>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_58Dg7EeY_5C62WjXWP1o7ktjZFZUUZoR6
SMTP_FROM=EZProject <noreply@yourdomain.com>

# ─── 7. RATE LIMITING ───────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── 8. FILE STORAGE ────────────────────────────
# Thư mục lưu file upload. Để trống → mặc định "uploads" trong Backend/.
# Production trên Render: filesystem là ephemeral, nên dùng Cloudinary.
UPLOAD_DIR=
MAX_FILE_SIZE=10485760
PROJECT_STORAGE_QUOTA_BYTES=1073741824

# ─── 9. ADMIN SEED — OPTIONAL ───────────────────
# Chạy 1 lần sau deploy: cd Backend && npm run seed:admin
# Hoặc dùng npm run seed (tạo 5 user test, password "123456")
# Để trống → dùng giá trị mặc định: admin@ezproject.dev / admin / Admin@2026!
ADMIN_EMAIL=admin@gmail.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=EzProject_Admin_123
