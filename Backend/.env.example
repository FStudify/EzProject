# ==========================================
# EZProject Backend — PRODUCTION (Render)
# ==========================================
# Đây là template cho môi trường PRODUCTION deploy trên Render.
# Cách dùng:
#   1. Vào Render Dashboard → chọn service backend
#   2. Environment → Add Environment Variable
#   3. Paste từng KEY=VALUE từ file này (thay thế <...> bằng giá trị thật)
#
# KHÔNG điền giá trị nhạy cảm trực tiếp vào file này.
# File này chỉ để tham khảo cấu trúc — commit lên git là an toàn.
# ==========================================

# ─── 1. RUNTIME ─────────────────────────────────
NODE_ENV=production
# Render tự inject PORT=10000, không cần set
PORT=10000

# ─── 2. DATABASE ─────────────────────────────────
# MongoDB Atlas connection string
# Lấy tại: Atlas → Connect → Drivers → copy string
# Thay <USER>, <PASSWORD>, <CLUSTER> bằng giá trị thật
MONGO_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/ezproject?retryWrites=true&w=majority&appName=<APPNAME>

# ─── 3. JWT ───────────────────────────────────────
# PHẢI dùng chuỗi random >= 32 ký tự, KHÁC nhau
# Render có nút "Generate" tạo tự động
JWT_SECRET=<random-string-min-32-chars>
JWT_REFRESH_SECRET=<another-random-string-min-32-chars>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── 4. CORS / FRONTEND URL ──────────────────────
# URL Vercel của frontend (lấy sau khi deploy Vercel)
# Nếu có custom domain thì thay bằng domain đó
CORS_ORIGIN=https://<your-app>.vercel.app
FRONTEND_URL=https://<your-app>.vercel.app

# ─── 5. GOOGLE OAUTH ─────────────────────────────
# Lấy tại: https://console.cloud.google.com/
#   APIs & Services → Credentials → OAuth 2.0 Client IDs
#
# Trong Google Console, thêm ĐỒNG THỜI cả 2 Authorized redirect URIs:
#   http://localhost:3000/api/v1/auth/google/callback        ← local dev
#   https://<your-render-app>.onrender.com/api/v1/auth/google/callback  ← production
#
# GOOGLE_CLIENT_ID và GOOGLE_CLIENT_SECRET dùng CHUNG 1 cặp cho cả local lẫn production
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
# Đổi thành URL Render production
GOOGLE_CALLBACK_URL=https://<your-render-app>.onrender.com/api/v1/auth/google/callback

# ─── 6. CLOUDINARY (Avatar upload) — OPTIONAL ────
# Bắt buộc nếu muốn upload avatar (Render không lưu file lâu dài)
# Đăng ký miễn phí: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ─── 7. EMAIL / SMTP — OPTIONAL ──────────────────
# Resend (khuyến nghị, free 100 email/ngày):
#   SMTP_HOST=smtp.resend.com  |  SMTP_PORT=465  |  SMTP_USER=resend
#   SMTP_PASS=<resend-api-key>  |  SMTP_FROM=EZProject <noreply@yourdomain.com>
#
# Gmail App Password:
#   1. Bật 2FA tại https://myaccount.google.com/security
#   2. Tạo App Password tại https://myaccount.google.com/apppasswords
#   3. Copy 16 ký tự vào SMTP_PASS
#   SMTP_HOST=smtp.gmail.com  |  SMTP_PORT=587  |  SMTP_USER=your@gmail.com
#   SMTP_PASS=<16-char-app-password>  |  SMTP_FROM=EZProject <your@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail@gmail.com>
SMTP_PASS=<16-char-app-password>
SMTP_FROM=EZProject <<your-gmail@gmail.com>>

# ─── 8. GOOGLE GEMINI AI — OPTIONAL ──────────────
# Lấy key miễn phí: https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

# ─── 9. RATE LIMITING ─────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── 10. FILE STORAGE ────────────────────────────
# Render filesystem là ephemeral → nên dùng Cloudinary thay vì lưu local
UPLOAD_DIR=
MAX_FILE_SIZE=10485760
PROJECT_STORAGE_QUOTA_BYTES=1073741824

# ─── 11. ADMIN SEED — OPTIONAL ───────────────────
# Chạy 1 lần sau deploy: npm run seed:admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-password>
