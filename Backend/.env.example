# ============================================================
# EzProject Backend Environment Variables
# ============================================================
# Sao chép file này thành `.env` và điền giá trị thật.
# Trên Render: Settings → Environment → Add từng biến.

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── MongoDB ─────────────────────────────────────────────────
# Ví dụ Atlas:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ezproject?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://EzProject:Ez123Ez@cluster0.g7xba9i.mongodb.net/ezproject?retryWrites=true&w=majority&appName=Cluster0

# ── JWT ─────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-random-64-chars
JWT_REFRESH_SECRET=replace-with-different-random-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d

# ── CORS / Frontend URL ─────────────────────────────────────
# Domain frontend (Vercel, Netlify, Cloudflare Pages...). KHÔNG có dấu / ở cuối.
# Khi dev local: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Origin được phép gọi API (CORS). Dùng dấu phẩy để nhiều domain:
#   CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Trên production: chỉ domain frontend chính.
CORS_ORIGIN=http://localhost:5173

# ── SMTP / Email ────────────────────────────────────────────
# Gmail: bật 2FA + tạo App Password (https://myaccount.google.com/apppasswords)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.email@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM=your.email@gmail.com
#
# Nếu KHÔNG cấu hình: hệ thống vẫn tạo được lời mời — trả về inviteUrl để copy thủ công.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Google Gemini AI (optional, cho AI Chat / AI Generate Project) ────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
