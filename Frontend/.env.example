# ==========================================
# EZProject Frontend — Environment Variables
# ==========================================
# LOCAL DEV:  Copy file này thành `.env` → chạy ngay (mặc định trỏ localhost:3000).
# DEPLOY:     Paste key vào Vercel/Netlify → đổi URL thành backend production.
# Mọi biến FE PHẢI có prefix VITE_ (Vite chỉ expose biến có prefix này ra client).
# ==========================================

# URL của Backend API.
# KHÔNG kèm /api/v1 (config.ts tự thêm), KHÔNG có dấu / ở cuối.
# Local dev : http://localhost:3000
# Production: https://your-backend.onrender.com  (lấy từ Render Dashboard)
VITE_API_URL=http://localhost:3000
