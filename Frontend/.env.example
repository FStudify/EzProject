# ==========================================
# EZProject Frontend — PRODUCTION (Vercel)
# ==========================================
# Cách dùng:
#   1. Vào Vercel Dashboard → chọn project frontend
#   2. Settings → Environment Variables
#   3. Thêm từng KEY=VALUE (thay <...> bằng giá trị thật)
#
# Mọi biến PHẢI có prefix VITE_ để Vite expose ra client.
# ==========================================

# URL backend Render — KHÔNG có /api/v1, KHÔNG có dấu / cuối
# Lấy tại: Render Dashboard → chọn service → copy URL dạng https://xxx.onrender.com
VITE_API_URL=https://<your-render-app>.onrender.com
